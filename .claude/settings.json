{
  "permissions": {
    "allow": [
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(make *)",
      "Bash(uv run *)",
      "Bash(uv sync *)",
      "Bash(uv lock *)",
      "Bash(swift build *)",
      "Bash(swift test *)",
      "Bash(swift format *)"
    ],
    "ask": [
      "Bash(git push *)"
    ],
    "deny": [
      "Read(~/Library/Messages/**)",
      "Read(~/Library/Mail/**)",
      "Read(~/Library/Application Support/TARS/**)",
      "Read(./**/.env*)",
      "mcp__Neon"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/check-endpoints.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/format-file.sh",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
